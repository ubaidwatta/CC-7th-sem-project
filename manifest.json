{
  "manifest_version": 3,
  "name": "PhishGuard Lite",
  "version": "1.0.0",
  "description": "Rule-based phishing detection that analyzes the URL of the current tab. No AI, no servers, no data collection.",
  "permissions": ["activeTab", "storage", "tabs", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PhishGuard Lite",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}